# ===== DSH Moments Agent 环境变量示例 =====
# 复制为 .env 仅供本机参考；项目本身不会自动读取 .env，
# 请由启动 DSH / 桌面执行器的进程环境注入。不要把真实值提交到 Git。

# --- WeChatAgent 适配器（可选） ---
# 从 WeChatAgent 的 state/hook/native-token.txt 与 state/wechat-io-config.json 获取
DSH_MOMENTS_READER_TOKEN=
DSH_MOMENTS_HOOK_TOKEN=
# 或者让插件从文件读取
# DSH_MOMENTS_READER_TOKEN_FILE=C:\path\to\reader-token.txt
# DSH_MOMENTS_HOOK_TOKEN_FILE=C:\path\to\native-token.txt

# --- 桌面执行器 ---
# 与 python desktop/server.py 生成的 token 文件一致
DSH_MOMENTS_DESKTOP_TOKEN=

# --- 本机管理页 ---
# 不设置时插件会在 data/admin-token.txt 自动生成（仅当 adminServer.enabled=true）
DSH_MOMENTS_ADMIN_TOKEN=

# --- 图像 Provider（全部默认关闭） ---
# 官方付费图像 API：必须同时设置 officialApiEnabled=true、预算与密钥才会启用
DSH_MOMENTS_OFFICIAL_IMAGE_API_KEY=
DSH_MOMENTS_IMAGE_BUDGET_USD=0
# 本地 ComfyUI（可选，仅回环地址）
DSH_MOMENTS_COMFYUI_URL=http://127.0.0.1:8188

# --- 自动发布（默认禁止） ---
# 只有显式设置为 1 且 profile 配置为 POLICY_AUTONOMOUS 时才可能放开；
# 仍受桌面执行器 --allow-publish 与审批门禁约束。
DSH_MOMENTS_ALLOW_AUTONOMOUS_PUBLISH=0
