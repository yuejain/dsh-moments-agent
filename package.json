{
  "name": "dsh-moments-agent",
  "version": "0.3.2",
  "private": true,
  "description": "DSH Moments Agent：以 DeepSeek Harness 为底座、面向 Windows 个人微信朋友圈的数字化人格创作与审批发布插件",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "persona",
    "config/*.example.*",
    "desktop/*.py",
    "desktop/requirements.txt",
    "desktop/README.md",
    "client/server.py",
    "client/discovery.py",
    "client/auto_configure.py",
    "client/web/app.js",
    "client/web/styles.css",
    "client/web/index.html",
    "client/README.md",
    "Start-Moments-Client.cmd",
    "Start-Moments-Client-Admin.cmd",
    "scripts",
    "docs",
    "!docs/audit/evidence/**",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "LICENSE",
    "skills/*/SKILL.md",
    "skills/*/LICENSE",
    "skills/*/SOURCE.json",
    "skills/*/RESEARCH.md"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-isolation=none \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:unit": "npm run build && node --test --test-isolation=none \"tests/unit/*.test.mjs\"",
    "test:integration": "npm run build && node --test --test-isolation=none \"tests/integration/*.test.mjs\"",
    "test:e2e": "node scripts/verify.mjs",
    "test:desktop": "python -X utf8 desktop/tests/run_tests.py",
    "test:client": "python -X utf8 -m unittest discover -s client/tests -v",
    "test:coverage": "npm run build && node --test --test-isolation=none --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"dist/**\" \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "desktop": "python desktop/server.py --token-file data/desktop-token.txt"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
